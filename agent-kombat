    "Round 0 independent $CONTRACT_NOUN generation" \
    "Writing: rounds/r0-agent2.jsonl"
  if ! (
    cd "$origin_cwd"
    codex exec \
      --model "$CODEX_MODEL" \
      --sandbox read-only \
      --skip-git-repo-check \
      --json \
      --output-schema "$schema_file" \
      --output-last-message "$structured_file" \
      "$(cat "$prompt_file")" \
      </dev/null
  ) >"$jsonl_file" 2>"$target/rounds/r0-agent2.stderr"; then
    log_event "$target" "agent.call.failed" "$(jq -n --arg agent agent2 --arg round r0 '{agent: $agent, round: $round}')"
    sed -n '1,80p' "$target/rounds/r0-agent2.stderr" >&2
    die "Codex round 0 call failed"
  fi

  session_id="$(extract_codex_session_id "$jsonl_file")"
  [[ -n "$session_id" ]] || die "Codex round 0 JSONL did not expose thread.started.thread_id"
  extract_codex_markdown_field "$structured_file" "$CONTRACT_OUTPUT_FIELD" >"$plan_file" \
    || die "Codex round 0 did not produce $CONTRACT_OUTPUT_FIELD"

  update_config "$target" --arg id "$session_id" '.agent2.session_id = $id'
  log_event "$target" "agent.call.completed" "$(jq -n --arg agent agent2 --arg round r0 --arg session_id "$session_id" '{agent: $agent, round: $round, session_id: $session_id}')"
}

run_codex_debate_turn() {
  local target="$1"
  local origin_cwd="$2"
  local round="$3"
  local schema_file="$4"
  local own_input="$5"
  local opponent_input="$6"
  local focus_file="${7:-}"
  local session_id
  local prompt_file="$target/rounds/r${round}-agent2.prompt.txt"
  local jsonl_file="$target/rounds/r${round}-agent2.jsonl"
  local structured_file="$target/rounds/r${round}-agent2.json"
  local plan_file="$target/rounds/r${round}-agent2.md"

  session_id="$(jq -r '.agent2.session_id' "$target/config.json")"
  [[ -n "$session_id" && "$session_id" != "null" ]] || die "missing Codex session id for debate resume"
  build_debate_prompt "$own_input" "$opponent_input" "$focus_file" >"$prompt_file"

  log_event "$target" "agent.call.started" "$(jq -n --arg agent agent2 --arg round "r${round}" '{agent: $agent, round: $round}')"
  progress_panel \
    "Waiting for Codex CLI" \
    "Round $round debate turn" \
    "Reading: agent artifacts" \
    "Writing: rounds/r${round}-agent2.json"
  if ! (
    cd "$origin_cwd"
    codex exec resume \
      -c 'sandbox_mode="read-only"' \
      --model "$CODEX_MODEL" \
      --skip-git-repo-check \
      --json \
      --output-last-message "$structured_file" \
      "$session_id" \
      "$(cat "$prompt_file")" \
      </dev/null
  ) >"$jsonl_file" 2>"$target/rounds/r${round}-agent2.stderr"; then
    log_event "$target" "agent.call.failed" "$(jq -n --arg agent agent2 --arg round "r${round}" '{agent: $agent, round: $round}')"
    sed -n '1,80p' "$target/rounds/r${round}-agent2.stderr" >&2
    die "Codex debate round $round failed"
  fi

  jq -e --arg id "$session_id" 'select(.type == "thread.started") | .thread_id == $id' "$jsonl_file" >/dev/null \
    || die "Codex debate round $round did not resume the expected thread id"
  validate_debater_response "$structured_file" \
    || die "Codex debate round $round failed debater schema validation"
  jq -er --arg field "$CONTRACT_REVISED_FIELD" '.[$field]' "$structured_file" >"$plan_file"
  log_event "$target" "agent.call.completed" "$(jq -n --arg agent agent2 --arg round "r${round}" --arg session_id "$session_id" '{agent: $agent, round: $round, session_id: $session_id}')"
}

