run_debate_loop() {
  local target="$1"
  local round
  if [[ "$ROUNDS" -eq 0 ]]; then
    return
  fi
  local start_round
  start_round="$(( $(jq -r '.published_round' "$target/config.json") + 1 ))"
  [[ "$start_round" -lt 1 ]] && start_round=1
  for ((round = start_round; round <= ROUNDS; round++)); do
    run_debate_round "$target" "$round"
  done
}

run_judge_loop() {
  local target="$1"
  if [[ "$NO_JUDGE" -eq 1 ]]; then
    return
  fi
  if [[ "$(jq -r '.status' "$target/config.json")" = "judged" && -f "$target/judge-verdict.json" ]]; then
    return
  fi
  if [[ "$(jq -r '.status' "$target/config.json")" = "done" ]]; then
    return
  fi

  local attempt=1
  while :; do
    step "Judge attempt $attempt"
    run_judge_attempt "$target" "$attempt"

    local recommendation
    local extra_used
    recommendation="$(jq -r '.recommendation' "$target/judge-verdict.json")"
    extra_used="$(jq -r '.extra_rounds_used' "$target/config.json")"

    if [[ "$recommendation" != "another_round" || "$extra_used" -ge "$MAX_EXTRA_ROUNDS" ]]; then
      update_config "$target" '.phase = "judge" | .status = "judged"'
      break
    fi

    local next_round
    local focus_file
    next_round="$(( $(jq -r '.published_round' "$target/config.json") + 1 ))"
    focus_file="$target/rounds/r${next_round}-judge-focus.txt"
    jq -r '.focus_for_next_round // "Focus on unresolved judge issues."' "$target/judge-verdict.json" >"$focus_file"
    update_config "$target" '.extra_rounds_used = (.extra_rounds_used + 1)'
    log_event "$target" "judge.replay.requested" "$(jq -n --argjson next_round "$next_round" --arg focus_path "rounds/r${next_round}-judge-focus.txt" '{next_round: $next_round, focus_path: $focus_path}')"
    run_debate_round "$target" "$next_round" "$focus_file"
    attempt="$((attempt + 1))"
  done
  ok "Judge verdict written"
}

run_synthesis() {
  local target="$1"
  local origin_cwd
  origin_cwd="$(jq -r '.origin_cwd' "$target/config.json")"

  local prompt_file="$target/rounds/synthesis.prompt.txt"
  local raw_file="$target/rounds/synthesis.raw.json"
  local session_id
  session_id="$(uuid)"

  build_synthesis_prompt "$target" >"$prompt_file"
  update_config "$target" --arg id "$session_id" '.phase = "synthesis" | .status = "running" | .synthesis = {name: "claude", model: .judge.model, session_id: $id}'
  log_event "$target" "synthesis.call.started" "$(jq -n --arg session_id "$session_id" '{session_id: $session_id}')"

  progress_panel \
    "Waiting for final synthesis" \
    "Combining the latest published artifacts" \
    "Writing: $CONTRACT_FINAL_FILENAME"
  if ! (
    cd "$origin_cwd"
    claude -p \
      --model "$JUDGE_MODEL" \
      --session-id "$session_id" \
      --permission-mode plan \
      --tools "" \
      --output-format json \
      "$(cat "$prompt_file")"
  ) >"$raw_file" 2>"$target/rounds/synthesis.stderr"; then
    log_event "$target" "synthesis.call.failed"
    sed -n '1,80p' "$target/rounds/synthesis.stderr" >&2
    die "synthesis failed"
  fi

  jq -e --arg id "$session_id" '.session_id == $id or .sessionId == $id' "$raw_file" >/dev/null \
    || die "synthesis did not report the expected session id"
  jq -er '.result | select(type == "string" and length > 0)' "$raw_file" >"$target/$CONTRACT_FINAL_FILENAME" \
    || die "synthesis did not produce Markdown result"
  update_config "$target" --arg artifact "$CONTRACT_FINAL_FILENAME" '.phase = "done" | .status = "done" | .last_successful_artifact = $artifact'
  log_event "$target" "synthesis.call.completed" "$(jq -n --arg session_id "$session_id" --arg artifact "$CONTRACT_FINAL_FILENAME" '{session_id: $session_id, artifact: $artifact}')"
  ok "$CONTRACT_FINAL_LABEL: $target/$CONTRACT_FINAL_FILENAME"
}

