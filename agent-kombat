  local input_agent1="$target/rounds/r${round}-input-agent1.md"
  local input_agent2="$target/rounds/r${round}-input-agent2.md"
  cp "$target/plan-agent1.md" "$input_agent1"
  cp "$target/plan-agent2.md" "$input_agent2"

  step "Round $round: debate"
  update_config "$target" --argjson round "$round" '.phase = "round" | .status = "running" | .current_round = $round'
  log_event "$target" "round.started" "$(jq -n --arg round "r${round}" '{round: $round}')"

  run_claude_debate_turn "$target" "$origin_cwd" "$round" "$schema_json" "$input_agent1" "$input_agent2" "$focus_file"
  run_codex_debate_turn "$target" "$origin_cwd" "$round" "$schema_file" "$input_agent2" "$input_agent1" "$focus_file"

