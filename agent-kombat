    sed -n '1,80p' "$target/rounds/r${round}-agent1.stderr" >&2
    die "Claude debate round $round failed"
  fi

  jq -e --arg id "$session_id" '.session_id == $id or .sessionId == $id' "$raw_file" >/dev/null \
    || die "Claude debate round $round did not resume the expected session id"
  extract_claude_structured "$raw_file" >"$structured_file" \
    || die "Claude debate round $round did not produce structured output"
  validate_debater_response "$structured_file" \
    || die "Claude debate round $round failed debater schema validation"
  jq -er --arg field "$CONTRACT_REVISED_FIELD" '.[$field]' "$structured_file" >"$plan_file"
  log_event "$target" "agent.call.completed" "$(jq -n --arg agent agent1 --arg round "r${round}" --arg session_id "$session_id" '{agent: $agent, round: $round, session_id: $session_id}')"
}

