prepare_round0_plan_context() {
  local target="$1"
  local origin_cwd="$2"
  local requirement_path
  local classification_file="$target/rounds/r0-plan-classification.json"
  local instructions_file="$target/rounds/r0-plan-instructions.md"

  [[ -f "$PLAN_CORE_PATH" ]] || die "missing bundled plan core: $PLAN_CORE_PATH"
  requirement_path="$(abs_path "$target/requirement.txt")"

  if ! python3 "$PLAN_CORE_PATH" classify \
    --repo-root "$origin_cwd" \
    --skill-root "$PLAN_SKILL_ROOT" \
    --request-file "$requirement_path" \
    >"$classification_file" 2>"$target/rounds/r0-plan-classification.stderr"; then
    sed -n '1,80p' "$target/rounds/r0-plan-classification.stderr" >&2
    die "Round 0 plan classification failed"
  fi

  if jq -e '.needs_clarification == true' "$classification_file" >/dev/null; then
    warn "plan classifier requested clarification: $(jq -r '.clarification_prompt' "$classification_file")"
  fi

  case "$CONTRACT_CONTEXT_MODE" in
    instructions)
      if ! python3 "$PLAN_CORE_PATH" render-instructions \
        --skill-root "$PLAN_SKILL_ROOT" \
        --classification "$classification_file" \
        >"$instructions_file" 2>"$target/rounds/r0-plan-instructions.stderr"; then
        sed -n '1,80p' "$target/rounds/r0-plan-instructions.stderr" >&2
        die "Round 0 planning instruction rendering failed"
      fi
      ;;
    context)
      if ! python3 "$PLAN_CORE_PATH" render-context \
        --skill-root "$PLAN_SKILL_ROOT" \
        --classification "$classification_file" \
        >"$instructions_file" 2>"$target/rounds/r0-plan-instructions.stderr"; then
        sed -n '1,80p' "$target/rounds/r0-plan-instructions.stderr" >&2
        die "Round 0 planning context rendering failed"
      fi
      ;;
    none)
      printf '%s\n' "# Shared Context" "" "No shared planning context requested by contract." >"$instructions_file"
      : >"$target/rounds/r0-plan-instructions.stderr"
      ;;
  esac

  log_event "$target" "plan.classified" "$(jq -c '{
    round: "r0",
    action,
    kind,
    mode,
    needs_clarification,
    plans_dir_source,
    classification_path: "rounds/r0-plan-classification.json",
    instructions_path: "rounds/r0-plan-instructions.md"
  }' "$classification_file" | jq -c --arg contract "$CONTRACT_ID" --arg context_mode "$CONTRACT_CONTEXT_MODE" '. + {contract: $contract, context_mode: $context_mode}')"
}

