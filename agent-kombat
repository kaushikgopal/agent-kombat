log_event() {
  local target="$1"
  local event="$2"
  local fields
  if [[ $# -ge 3 ]]; then
    fields="$3"
  else
    fields='{}'
  fi
  jq -cn \
    --arg ts "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --arg event "$event" \
    --argjson fields "$fields" \
    '{ts: $ts, event: $event} + $fields' >>"$target/events.jsonl"
}

