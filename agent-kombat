#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR_CANDIDATE="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" = /* ]] || SCRIPT_SOURCE="$SCRIPT_DIR_CANDIDATE/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
PLAN_SKILL_ROOT="${AGENT_KOMBAT_PLAN_SKILL_ROOT:-$SCRIPT_DIR/skills/plan}"
PLAN_CORE_PATH="${AGENT_KOMBAT_PLAN_CORE_PATH:-$PLAN_SKILL_ROOT/scripts/plan_core.py}"

ENV_CLAUDE_MODEL="${CLAUDE_MODEL:-}"
ENV_CODEX_MODEL="${CODEX_MODEL:-}"
ENV_AGENT_KOMBAT_CLAUDE_MODEL="${AGENT_KOMBAT_CLAUDE_MODEL:-}"
ENV_AGENT_KOMBAT_CODEX_MODEL="${AGENT_KOMBAT_CODEX_MODEL:-}"
ENV_AGENT_KOMBAT_JUDGE_MODEL="${AGENT_KOMBAT_JUDGE_MODEL:-}"

ROUNDS=3
MAX_EXTRA_ROUNDS=1
WORKDIR=""
DRY_RUN=0
CONTRACT_CHECK=0
NO_COLOR_FLAG=0
NO_INTERACTIVE=0
INTERACTIVE=0
NO_JUDGE=0
SHOW_WORKDIR=""
RESUME_WORKDIR=""
REQUIREMENT_FILE=""
CONTRACT_SPEC="plan"
CLAUDE_MODEL="opus"
CODEX_MODEL="gpt-5"
JUDGE_MODEL="opus"
CLAUDE_MODEL_SOURCE="default"
CODEX_MODEL_SOURCE="default"
JUDGE_MODEL_SOURCE="default"
REQUIREMENT=""

CONTRACT_ID="plan"
CONTRACT_NOUN="plan"
CONTRACT_OUTPUT_FIELD="plan_markdown"
CONTRACT_REVISED_FIELD="revised_plan_markdown"
CONTRACT_FINAL_FILENAME="plan-final.md"
CONTRACT_FINAL_LABEL="Final plan"
CONTRACT_CONTEXT_MODE="instructions"
CONTRACT_INITIAL_TASK="Create an implementation plan for the requirement below."
CONTRACT_DEBATE_TASK="You are revising your own plan after seeing a competing plan."
CONTRACT_SYNTHESIS_TASK="You are synthesizing the final implementation plan from an Agent Kombat debate."
CONTRACT_ROUND0_NOTE="Treat this as plan generation, not implementation."
CONTRACT_SYNTHESIS_NOTE="Produce a concise, auditable Markdown plan. Do not execute the plan."
CONTRACT_SOURCE="builtin:plan"

COLOR_RESET=""
COLOR_DIM=""
COLOR_RED=""
COLOR_GREEN=""
COLOR_YELLOW=""
COLOR_BLUE=""

usage() {
  cat <<'USAGE'
Usage:
  agent-kombat [options] "requirement"
  agent-kombat --contract-check
  agent-kombat --show WORKDIR
  agent-kombat --resume WORKDIR

Options:
  -r, --rounds N           Debate rounds after round 0 (default: 3)
  -m, --max-extra N        Maximum focused replay rounds (default: 1)
  -d, --workdir DIR        Debate artifact directory
      --claude-model NAME  Claude model alias/name (default: env or opus)
      --codex-model NAME   Codex model alias/name (default: env or gpt-5)
      --judge-model NAME   Judge model alias/name (default: Claude model)
      --contract SPEC      Debate contract: plan, artifact, or path to JSON
      --dry-run            Print intended configuration without agent calls
      --contract-check     Probe Claude and Codex automation contracts
      --no-judge           Skip judge and replay logic
      --requirement-file F Read requirement text from a file
      --show WORKDIR       Print latest state for a debate directory
      --resume WORKDIR     Resume from durable state
      --interactive        Allow optional terminal prompts
      --no-interactive     Disable optional terminal prompts
      --no-color           Disable ANSI color output
  -h, --help               Show this help
USAGE
}

die() {
  printf '%serror:%s %s\n' "$COLOR_RED" "$COLOR_RESET" "$*" >&2
  exit 1
}

contract_die() {
  printf '%scontract:%s %s\n' "$COLOR_RED" "$COLOR_RESET" "$*" >&2
  exit 2
}

info() { printf '%s%s%s\n' "$COLOR_DIM" "$*" "$COLOR_RESET"; }
step() { printf '%s==>%s %s\n' "$COLOR_BLUE" "$COLOR_RESET" "$*"; }
ok() { printf '%sok:%s %s\n' "$COLOR_GREEN" "$COLOR_RESET" "$*"; }
warn() { printf '%swarn:%s %s\n' "$COLOR_YELLOW" "$COLOR_RESET" "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

gum_progress_enabled() {
  have gum && [[ -t 1 ]]
}

progress_panel() {
  gum_progress_enabled || return 0
  gum style --border normal --padding "0 2" --margin "1 0" "$@" || true
}

json_escape() {
  jq -Rn --arg v "$1" '$v'
}

sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

write_atomic() {
  local target="$1"
  local tmp
  tmp="$(mktemp "${target}.tmp.XXXXXX")"
  cat >"$tmp"
  mv "$tmp" "$target"
}

abs_path() {
  local path="$1"
  if [[ "$path" = /* ]]; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "$PWD" "$path"
  fi
}

init_color() {
  if [[ "$NO_COLOR_FLAG" -eq 1 || -n "${NO_COLOR:-}" || ! -t 1 ]]; then
    return
  fi
  COLOR_RESET=$'\033[0m'
  COLOR_DIM=$'\033[2m'
  COLOR_RED=$'\033[31m'
  COLOR_GREEN=$'\033[32m'
  COLOR_YELLOW=$'\033[33m'
  COLOR_BLUE=$'\033[34m'
}

parse_uint() {
  local name="$1"
  local value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a non-negative integer"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--rounds)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        parse_uint "rounds" "$2"
        ROUNDS="$2"
        shift 2
        ;;
      -m|--max-extra|--max-extra-rounds)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        parse_uint "max extra rounds" "$2"
        MAX_EXTRA_ROUNDS="$2"
        shift 2
        ;;
      -d|--workdir)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        WORKDIR="$2"
        shift 2
        ;;
      --claude-model)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        CLAUDE_MODEL="$2"
        CLAUDE_MODEL_SOURCE="arg"
        shift 2
        ;;
      --codex-model)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        CODEX_MODEL="$2"
        CODEX_MODEL_SOURCE="arg"
        shift 2
        ;;
      --judge-model)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        JUDGE_MODEL="$2"
        JUDGE_MODEL_SOURCE="arg"
        shift 2
        ;;
      --contract)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        CONTRACT_SPEC="$2"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --contract-check)
        CONTRACT_CHECK=1
        shift
        ;;
      --no-color)
        NO_COLOR_FLAG=1
        shift
        ;;
      --no-interactive)
        NO_INTERACTIVE=1
        shift
        ;;
      --interactive)
        INTERACTIVE=1
        shift
        ;;
      --no-judge)
        NO_JUDGE=1
        shift
        ;;
      --requirement-file)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        REQUIREMENT_FILE="$2"
        shift 2
        ;;
      --show)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SHOW_WORKDIR="$2"
        shift 2
        ;;
      --resume)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESUME_WORKDIR="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --version)
        printf '%s\n' "$VERSION"
        exit 0
        ;;
      --)
        shift
        REQUIREMENT="${*:-}"
        break
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        if [[ -n "$REQUIREMENT" ]]; then
          REQUIREMENT="$REQUIREMENT $1"
        else
          REQUIREMENT="$1"
        fi
        shift
        ;;
    esac
  done
}

should_run_intake() {
  [[ -z "$REQUIREMENT" ]] || return 1
  [[ -z "$REQUIREMENT_FILE" ]] || return 1
  [[ -z "$SHOW_WORKDIR" ]] || return 1
  [[ -z "$RESUME_WORKDIR" ]] || return 1
  [[ "$CONTRACT_CHECK" -eq 0 ]] || return 1
  [[ "$NO_INTERACTIVE" -eq 0 ]] || return 1
  [[ -t 0 && -t 1 ]] || return 1
  return 0
}

read_plain_input() {
  local prompt="$1"
  local value
  printf '%s: ' "$prompt" >&2
  read -r value
  printf '%s\n' "$value"
}

run_interactive_intake() {
  if ! should_run_intake; then
    return
  fi

  local source
  if have gum; then
    gum style --border normal --padding "1 2" --margin "1 0" \
      "AGENT KOMBAT" \
      "Start with a prompt, an existing plan file, or both." \
      "Tip: if you have a plan file, let Agent Kombat read it here instead of only mentioning the path in the prompt."
    source="$(gum choose \
      "Write a prompt" \
      "Use an existing plan file" \
      "Prompt + plan file")"
  else
    step "Agent Kombat intake"
    info "Choose input source:"
    info "1) Write a prompt"
    info "2) Use an existing plan file"
    info "3) Prompt + plan file"
    source="$(read_plain_input "Choice [1-3]")"
  fi

  case "$source" in
    "Write a prompt"|1)
      if have gum; then
        REQUIREMENT="$(gum write --placeholder "Describe the requirement or decision you want debated")"
      else
        REQUIREMENT="$(read_plain_input "Prompt")"
      fi
      ;;
    "Use an existing plan file"|2)
      if have gum; then
        REQUIREMENT_FILE="$(gum input --placeholder "sample-plan.md" --prompt "Plan file: ")"
      else
        REQUIREMENT_FILE="$(read_plain_input "Plan file")"
      fi
      ;;
    "Prompt + plan file"|3)
      if have gum; then
        REQUIREMENT="$(gum write --placeholder "What should the agents focus on while debating this plan?")"
        REQUIREMENT_FILE="$(gum input --placeholder "sample-plan.md" --prompt "Plan file: ")"
      else
        REQUIREMENT="$(read_plain_input "Prompt")"
        REQUIREMENT_FILE="$(read_plain_input "Plan file")"
      fi
      ;;
    *)
      die "cancelled"
      ;;
  esac
}

load_requirement_file() {
  if [[ -z "$REQUIREMENT_FILE" ]]; then
    return
  fi
  [[ -f "$REQUIREMENT_FILE" ]] || die "requirement file does not exist: $REQUIREMENT_FILE"

  local file_text
  file_text="$(cat "$REQUIREMENT_FILE")"
  if [[ -n "$REQUIREMENT" ]]; then
    REQUIREMENT="$(cat <<EOF
$REQUIREMENT

<user-input-plan>
source: $REQUIREMENT_FILE
$file_text
</user-input-plan>
EOF
)"
  else
    REQUIREMENT="$file_text"
  fi
}

extract_prompt_file_refs() {
  if [[ -z "$REQUIREMENT" ]]; then
    return
  fi
  printf '%s\n' "$REQUIREMENT" |
    tr '[:space:]' '\n' |
    sed -E -n 's/^@(.+)$/\1/p' |
    sed 's/[,.;:!?)]$//' |
    awk 'NF && !seen[$0]++'
}

expand_prompt_file_refs() {
  local refs
  refs="$(extract_prompt_file_refs)"
  [[ -n "$refs" ]] || return 0

  local addition=""
  local ref
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    case "$ref" in
      -*|*"://"*)
        die "unsupported @file reference: @$ref"
        ;;
    esac
    [[ -f "$ref" ]] || die "referenced @file does not exist: $ref"
    addition="$(cat <<EOF
$addition

<user-input-plan>
source: $ref
$(cat "$ref")
</user-input-plan>
EOF
)"
  done <<<"$refs"

  REQUIREMENT="$(cat <<EOF
$REQUIREMENT
$addition
EOF
)"
}

init_model_defaults() {
  if [[ -n "$ENV_AGENT_KOMBAT_CLAUDE_MODEL" ]]; then
    CLAUDE_MODEL="$ENV_AGENT_KOMBAT_CLAUDE_MODEL"
    CLAUDE_MODEL_SOURCE="env:AGENT_KOMBAT_CLAUDE_MODEL"
  elif [[ -n "$ENV_CLAUDE_MODEL" ]]; then
    CLAUDE_MODEL="$ENV_CLAUDE_MODEL"
    CLAUDE_MODEL_SOURCE="env:CLAUDE_MODEL"
  fi

  if [[ -n "$ENV_AGENT_KOMBAT_CODEX_MODEL" ]]; then
    CODEX_MODEL="$ENV_AGENT_KOMBAT_CODEX_MODEL"
    CODEX_MODEL_SOURCE="env:AGENT_KOMBAT_CODEX_MODEL"
  elif [[ -n "$ENV_CODEX_MODEL" ]]; then
    CODEX_MODEL="$ENV_CODEX_MODEL"
    CODEX_MODEL_SOURCE="env:CODEX_MODEL"
  fi

  if [[ -n "$ENV_AGENT_KOMBAT_JUDGE_MODEL" ]]; then
    JUDGE_MODEL="$ENV_AGENT_KOMBAT_JUDGE_MODEL"
    JUDGE_MODEL_SOURCE="env:AGENT_KOMBAT_JUDGE_MODEL"
  elif [[ "$CLAUDE_MODEL_SOURCE" != "default" ]]; then
    JUDGE_MODEL="$CLAUDE_MODEL"
    JUDGE_MODEL_SOURCE="derived:claude"
  fi
}

load_local_config_defaults() {
  local config=""
  local candidate
  for candidate in ".agent-kombat/config.json" "agent-kombat.json" "${XDG_CONFIG_HOME:-$HOME/.config}/agent-kombat/config.json"; do
    if [[ -f "$candidate" ]]; then
      config="$candidate"
      break
    fi
  done
  [[ -n "$config" ]] || return 0

  if [[ "$CLAUDE_MODEL_SOURCE" = "default" ]]; then
    local value
    value="$(jq -r '.claude_model // empty' "$config")"
    if [[ -n "$value" ]]; then
      CLAUDE_MODEL="$value"
      CLAUDE_MODEL_SOURCE="config:$config"
    fi
  fi
  if [[ "$CODEX_MODEL_SOURCE" = "default" ]]; then
    local value
    value="$(jq -r '.codex_model // empty' "$config")"
    if [[ -n "$value" ]]; then
      CODEX_MODEL="$value"
      CODEX_MODEL_SOURCE="config:$config"
    fi
  fi
  if [[ "$JUDGE_MODEL_SOURCE" = "default" ]]; then
    local value
    value="$(jq -r '.judge_model // empty' "$config")"
    if [[ -n "$value" ]]; then
      JUDGE_MODEL="$value"
      JUDGE_MODEL_SOURCE="config:$config"
    fi
  fi
}

resolve_derived_judge_model() {
  if [[ "$JUDGE_MODEL_SOURCE" = "default" ]]; then
    JUDGE_MODEL="$CLAUDE_MODEL"
    JUDGE_MODEL_SOURCE="derived:claude"
  fi
}

preflight_tools() {
  local missing=()
  local tool
  for tool in jq python3 claude codex; do
    if ! have "$tool"; then
      missing+=("$tool")
    fi
  done
  if [[ "${#missing[@]}" -gt 0 ]]; then
    die "missing required tool(s): ${missing[*]}"
  fi
}

preflight_jq() {
  have jq || die "missing required tool: jq"
}

validate_json_field_name() {
  local name="$1"
  local value="$2"
  [[ "$value" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "contract $name must be a JSON field name: $value"
}

validate_contract_context_mode() {
  case "$CONTRACT_CONTEXT_MODE" in
    instructions|context|none) ;;
    *) die "contract context_mode must be one of: instructions, context, none" ;;
  esac
}

validate_contract_filename() {
  [[ -n "$CONTRACT_FINAL_FILENAME" ]] || die "contract final_filename must not be empty"
  [[ "$CONTRACT_FINAL_FILENAME" != */* && "$CONTRACT_FINAL_FILENAME" != *".."* ]] \
    || die "contract final_filename must be a simple filename: $CONTRACT_FINAL_FILENAME"
}

validate_contract_loaded() {
  [[ -n "$CONTRACT_ID" ]] || die "contract id must not be empty"
  [[ -n "$CONTRACT_NOUN" ]] || die "contract noun must not be empty"
  [[ -n "$CONTRACT_INITIAL_TASK" ]] || die "contract initial_task must not be empty"
  [[ -n "$CONTRACT_DEBATE_TASK" ]] || die "contract debate_task must not be empty"
  [[ -n "$CONTRACT_SYNTHESIS_TASK" ]] || die "contract synthesis_task must not be empty"
  [[ -n "$CONTRACT_SYNTHESIS_NOTE" ]] || die "contract synthesis_note must not be empty"
  validate_json_field_name output_field "$CONTRACT_OUTPUT_FIELD"
  validate_json_field_name revised_field "$CONTRACT_REVISED_FIELD"
  validate_contract_context_mode
  validate_contract_filename
}

load_builtin_contract() {
  local name="$1"
  case "$name" in
    plan)
      CONTRACT_ID="plan"
      CONTRACT_NOUN="plan"
      CONTRACT_OUTPUT_FIELD="plan_markdown"
      CONTRACT_REVISED_FIELD="revised_plan_markdown"
      CONTRACT_FINAL_FILENAME="plan-final.md"
      CONTRACT_FINAL_LABEL="Final plan"
      CONTRACT_CONTEXT_MODE="instructions"
      CONTRACT_INITIAL_TASK="Create an implementation plan for the requirement below."
      CONTRACT_DEBATE_TASK="You are revising your own plan after seeing a competing plan."
      CONTRACT_SYNTHESIS_TASK="You are synthesizing the final implementation plan from an Agent Kombat debate."
      CONTRACT_ROUND0_NOTE="Treat this as plan generation, not implementation."
      CONTRACT_SYNTHESIS_NOTE="Produce a concise, auditable Markdown plan. Do not execute the plan."
      CONTRACT_SOURCE="builtin:plan"
      ;;
    artifact)
      CONTRACT_ID="artifact"
      CONTRACT_NOUN="artifact"
      CONTRACT_OUTPUT_FIELD="artifact_markdown"
      CONTRACT_REVISED_FIELD="revised_artifact_markdown"
      CONTRACT_FINAL_FILENAME="artifact-final.md"
      CONTRACT_FINAL_LABEL="Final artifact"
      CONTRACT_CONTEXT_MODE="context"
      CONTRACT_INITIAL_TASK="Create the requested artifact for the requirement below."
      CONTRACT_DEBATE_TASK="You are revising your own artifact after seeing a competing artifact."
      CONTRACT_SYNTHESIS_TASK="You are synthesizing the final requested artifact from an Agent Kombat debate."
      CONTRACT_ROUND0_NOTE="Do not create a plan unless the requirement explicitly asks for a plan."
      CONTRACT_SYNTHESIS_NOTE="Produce the requested artifact itself. Do not produce a plan, critique, or explanation unless the requirement asks for one."
      CONTRACT_SOURCE="builtin:artifact"
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

json_contract_field() {
  local file="$1"
  local key="$2"
  local fallback="$3"
  jq -er --arg key "$key" --arg fallback "$fallback" \
    '.[$key] // $fallback | select(type == "string")' "$file"
}

load_json_contract() {
  local file="$1"
  [[ -f "$file" ]] || die "contract file does not exist: $file"
  jq -e 'type == "object"' "$file" >/dev/null || die "contract file must be a JSON object: $file"

  CONTRACT_ID="$(json_contract_field "$file" id "$(basename "$file")")"
  CONTRACT_NOUN="$(json_contract_field "$file" noun "$CONTRACT_NOUN")"
  CONTRACT_OUTPUT_FIELD="$(json_contract_field "$file" output_field "$CONTRACT_OUTPUT_FIELD")"
  CONTRACT_REVISED_FIELD="$(json_contract_field "$file" revised_field "$CONTRACT_REVISED_FIELD")"
  CONTRACT_FINAL_FILENAME="$(json_contract_field "$file" final_filename "$CONTRACT_FINAL_FILENAME")"
  CONTRACT_FINAL_LABEL="$(json_contract_field "$file" final_label "$CONTRACT_FINAL_LABEL")"
  CONTRACT_CONTEXT_MODE="$(json_contract_field "$file" context_mode "$CONTRACT_CONTEXT_MODE")"
  CONTRACT_INITIAL_TASK="$(json_contract_field "$file" initial_task "$CONTRACT_INITIAL_TASK")"
  CONTRACT_DEBATE_TASK="$(json_contract_field "$file" debate_task "$CONTRACT_DEBATE_TASK")"
  CONTRACT_SYNTHESIS_TASK="$(json_contract_field "$file" synthesis_task "$CONTRACT_SYNTHESIS_TASK")"
  CONTRACT_ROUND0_NOTE="$(json_contract_field "$file" round0_note "$CONTRACT_ROUND0_NOTE")"
  CONTRACT_SYNTHESIS_NOTE="$(json_contract_field "$file" synthesis_note "$CONTRACT_SYNTHESIS_NOTE")"
  CONTRACT_SOURCE="$(abs_path "$file")"
}

load_contract() {
  if load_builtin_contract "$CONTRACT_SPEC"; then
    validate_contract_loaded
    return
  fi

  load_builtin_contract artifact
  load_json_contract "$CONTRACT_SPEC"
  validate_contract_loaded
}

tool_version() {
  local tool="$1"
  case "$tool" in
    claude)
      claude --version 2>/dev/null | head -n 1
      ;;
    codex)
      codex --version 2>/dev/null | sed '/^$/d' | tail -n 1
      ;;
    jq)
      jq --version 2>/dev/null | head -n 1
      ;;
    gum)
      gum --version 2>/dev/null | head -n 1
      ;;
  esac
}

default_workdir() {
  date '+debate_%Y%m%d_%H%M%S'
}

write_config() {
  local target="$1"
  local origin_cwd="$2"
  local phase="$3"
  local status="$4"
  local config_file="${5:-$target/config.json}"
  local judge_enabled="true"
  [[ "$NO_JUDGE" -eq 1 ]] && judge_enabled="false"

  jq -n \
    --arg origin_cwd "$origin_cwd" \
    --arg workdir "$(abs_path "$target")" \
    --arg phase "$phase" \
    --arg status "$status" \
    --arg contract_id "$CONTRACT_ID" \
    --arg contract_noun "$CONTRACT_NOUN" \
    --arg contract_source "$CONTRACT_SOURCE" \
    --arg contract_output_field "$CONTRACT_OUTPUT_FIELD" \
    --arg contract_revised_field "$CONTRACT_REVISED_FIELD" \
    --arg contract_final_filename "$CONTRACT_FINAL_FILENAME" \
    --arg contract_final_label "$CONTRACT_FINAL_LABEL" \
    --arg contract_context_mode "$CONTRACT_CONTEXT_MODE" \
    --arg contract_initial_task "$CONTRACT_INITIAL_TASK" \
    --arg contract_debate_task "$CONTRACT_DEBATE_TASK" \
    --arg contract_synthesis_task "$CONTRACT_SYNTHESIS_TASK" \
    --arg contract_round0_note "$CONTRACT_ROUND0_NOTE" \
    --arg contract_synthesis_note "$CONTRACT_SYNTHESIS_NOTE" \
    --arg claude_model "$CLAUDE_MODEL" \
    --arg codex_model "$CODEX_MODEL" \
    --arg judge_model "$JUDGE_MODEL" \
    --arg claude_source "$CLAUDE_MODEL_SOURCE" \
    --arg codex_source "$CODEX_MODEL_SOURCE" \
    --arg judge_source "$JUDGE_MODEL_SOURCE" \
    --arg claude_path "$(command -v claude)" \
    --arg codex_path "$(command -v codex)" \
    --arg jq_path "$(command -v jq)" \
    --arg gum_path "$(command -v gum || true)" \
    --arg claude_version "$(tool_version claude)" \
    --arg codex_version "$(tool_version codex)" \
    --arg jq_version "$(tool_version jq)" \
    --arg gum_version "$(if have gum; then tool_version gum; fi)" \
    --argjson rounds "$ROUNDS" \
    --argjson max_extra "$MAX_EXTRA_ROUNDS" \
    --argjson judge_enabled "$judge_enabled" \
    '{
      origin_cwd: $origin_cwd,
      workdir: $workdir,
      phase: $phase,
      contract: {
        id: $contract_id,
        noun: $contract_noun,
        source: $contract_source,
        output_field: $contract_output_field,
        revised_field: $contract_revised_field,
        final_filename: $contract_final_filename,
        final_label: $contract_final_label,
        context_mode: $contract_context_mode,
        initial_task: $contract_initial_task,
        debate_task: $contract_debate_task,
        synthesis_task: $contract_synthesis_task,
        round0_note: $contract_round0_note,
        synthesis_note: $contract_synthesis_note
      },
      published_round: -1,
      extra_rounds_used: 0,
      agent1: {
        name: "claude",
        model: $claude_model,
        model_source: $claude_source,
        session_id: null
      },
      agent2: {
        name: "codex",
        model: $codex_model,
        model_source: $codex_source,
        session_id: null
      },
      judge: {
        name: "claude",
        model: $judge_model,
        model_source: $judge_source,
        session_id: null
      },
      harnesses: {
